# P3 Lending Protocol - Local Development Environment
# All services running locally - no external dependencies

# Frontend - Local Auth (bypassing Supabase)
VITE_SUPABASE_URL=http://localhost:5001
VITE_SUPABASE_ANON_KEY=local_development_anon_key_placeholder_20chars
VITE_BACKEND_URL=http://localhost:5001
VITE_API_KEY=local_test_api_key_for_development
VITE_GOOGLE_CLIENT_ID=local_google_client_id_placeholder
VITE_BETA_FEATURE_FLAGS={}

# Local PostgreSQL Database
DATABASE_URL=postgresql://p3user:p3password@localhost:5432/p3lending
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=p3lending
POSTGRES_USER=p3user
POSTGRES_PASSWORD=p3password

# Backend
PORT=5001
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=http://localhost:5432
SUPABASE_ANON_KEY=local_anon_key
SUPABASE_SERVICE_ROLE_KEY=local_service_role_key

# Local Email Server (Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@p3lending.local
SMTP_SECURE=false
