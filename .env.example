# 1. Copy this file and rename it to ".env"
# 2. Add your keys below
# 3. Restart the server (npm run dev)

# Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
# Keep both for compatibility in local and Netlify builds.
API_KEY=your_gemini_api_key_here
VITE_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID (Get from: Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Supabase (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: CoinGecko API Key (Leave blank to use free tier)
COINGECKO_API_KEY=

# Netlify Identity Admin Invite Controls (used by netlify/functions/netlify-identity-admin.mjs)
NETLIFY_IDENTITY_ADMIN_TOKEN=
NETLIFY_ADMIN_ALLOWED_EMAIL_DOMAINS=p3lending.space
NETLIFY_ADMIN_ALLOWED_EMAILS=
# Optional override if needed; default derives from current Netlify site origin
NETLIFY_IDENTITY_URL=
