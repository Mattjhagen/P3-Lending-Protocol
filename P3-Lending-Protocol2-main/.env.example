# P3 Lending Protocol environment template
# Copy to .env.local for local development. Do not commit real secrets.

# --- Frontend required ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_BACKEND_URL=http://localhost:3001
VITE_ESCROW_CONTRACT_SEPOLIA=
VITE_ESCROW_CONTRACT_MAINNET=

# --- Frontend optional ---
VITE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_COINGECKO_API_KEY=

# --- Frontend legacy compatibility (optional) ---
API_KEY=
GOOGLE_CLIENT_ID=
COINGECKO_API_KEY=

# --- Backend required ---
PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Stripe optional (backend) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=usd

# --- Blockchain optional (backend) ---
ETH_RPC_URL=http://127.0.0.1:8545
P3_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000

# --- Netlify Identity Admin (Netlify Functions) ---
NETLIFY_IDENTITY_ADMIN_TOKEN=
NETLIFY_IDENTITY_URL=https://your-site-domain/.netlify/identity
NETLIFY_ADMIN_ALLOWED_EMAIL_DOMAINS=p3lending.space
NETLIFY_ADMIN_ALLOWED_EMAILS=

NODE_ENV=development
